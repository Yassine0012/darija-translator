{
  "manifest_version": 3,
  "name": "Darija Translator",
  "version": "1.0.0",
  "description": "Translate selected text into Moroccan Darija in the side panel, using your own REST service.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "contextMenus", "storage", "activeTab", "scripting"],
  "host_permissions": [
    "http://localhost:8080/*",
    "http://127.0.0.1:8080/*"
  ],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Translate selection to Darija" }
}
